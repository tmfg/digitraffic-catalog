# CKAN runtime config for local dev, CI tests and the AI devcontainer venv.
#
# Read by docker compose (env_file in compose.yaml) AND by bash (ckan-venv.sh sources it),
# so keep to what both parse the same way:
#   KEY=value or KEY="value with spaces or <, >, &"; no ${...} interpolation; no export.
# Secrets and personal overrides go in .env.local (see .env.local.example), which is loaded
# after this file and wins.
CKAN_SITE_ID=dt-catalog
CKAN_SITE_URL=http://localhost:5000
CKAN__PLUGINS="datastore dcat digitraffic_core envvars scheming_datasets scheming_groups scheming_organizations stats entraid_authenticator digitraffic_fluent digitraffic_opentelemetry"
CKAN__FAVICON=favicon.ico
CKAN__DISPLAY_TIMEZONE=Europe/Helsinki

CKAN__AUTH__USER_CREATE_GROUPS=false
CKAN__AUTH__USER_CREATE_ORGANIZATIONS=false
CKAN__AUTH__USER_DELETE_GROUPS=false
CKAN__AUTH__USER_DELETE_ORGANIZATIONS=false

CKAN_STORAGE_PATH=/var/lib/ckan
CKAN_ARCHIVER_PATH=/var/lib/ckan/archiver
CKAN_WEBASSETS_PATH=/var/lib/ckan/webassets
CKAN_BEAKER_SESSION_SECRET=0000

# Local-only databases created by postgresql/init-local.sql.
CKAN_SQLALCHEMY_URL=postgresql://ckan_default:password1234@catalog-postgresql:5432/ckan_default
CKAN_DATASTORE_WRITE_URL=postgresql://ckan_default:password1234@catalog-postgresql:5432/datastore_default
CKAN_DATASTORE_READ_URL=postgresql://datastore_default:1234password@catalog-postgresql:5432/datastore_default
CKAN_SOLR_URL=http://catalog-solr:8983/solr/ckan
TEST_CKAN_SOLR_URL=http://catalog-solr:8983/solr/ckan
CKAN_REDIS_URL=redis://catalog-redis:6379/1

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# Placeholders so entraid_authenticator loads; real test-app values go in .env.local.
ENTRA_CLIENT_ID="<client-id>"
ENTRA_CLIENT_SECRET="<client-secret>"
ENTRA_AUTHORITY="https://login.microsoftonline.com/<tenant-id>"
