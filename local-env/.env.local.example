# Copy to .env.local (gitignored). Every line is optional; values here override ckan.env.
# Same syntax rules as ckan.env: quote values containing spaces or < > &.

# Entra ID test app registration — only needed to log in via Entra locally.
#ENTRA_CLIENT_ID=
#ENTRA_CLIENT_SECRET=
#ENTRA_AUTHORITY=
#CKAN_SITE_URL=http://localhost:5000

# E2E (Playwright) sysadmin, inserted into the database on every start by
# ckan/docker-entrypoint.d/40-test-users.sh.
#E2E_SYSADMIN_ID=
#E2E_SYSADMIN_NAME=
#E2E_SYSADMIN_EMAIL=
#E2E_SYSADMIN_FULLNAME=
