# Copy to .env.local (gitignored). Every line is optional; values here override ckan.env.
# Same syntax rules as ckan.env: quote values containing spaces or < > &.

# Entra ID test app registration — only needed to log in via Entra locally.
#ENTRA_CLIENT_ID=
#ENTRA_CLIENT_SECRET=
#ENTRA_AUTHORITY=
#CKAN_SITE_URL=http://localhost:5000

# E2E (Playwright) sysadmin, inserted into the database on every start by
# ckan/docker-entrypoint.d/40-test-users.sh.
#E2E_SYSADMIN_ID=
#E2E_SYSADMIN_NAME=
#E2E_SYSADMIN_EMAIL=
#E2E_SYSADMIN_FULLNAME=

# VACO validation, run with `ckan digitraffic-vaco submit`.
#CKANEXT__DIGITRAFFIC_CORE__VACO__ENABLED=true
#CKANEXT__DIGITRAFFIC_CORE__VACO__API_BASE_URL=
#CKANEXT__DIGITRAFFIC_CORE__VACO__TOKEN_URL=
#CKANEXT__DIGITRAFFIC_CORE__VACO__CLIENT_ID=
#CKANEXT__DIGITRAFFIC_CORE__VACO__CLIENT_SECRET=
#CKANEXT__DIGITRAFFIC_CORE__VACO__SCOPE=
